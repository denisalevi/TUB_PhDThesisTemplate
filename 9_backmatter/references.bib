  author = {McFarlan, Amanda R. and Chou, Christina Y. C. and Watanabe, Airi and Cherepacha, Nicole and Haddad, Maria and Owens, Hannah and Sj{\"o}str{\"o}m, P. Jesper},
  year = 2022,
