@article{Faghihi2017,
  title = {A Computational Model of Conditioning Inspired by {{Drosophila}} Olfactory System},
  author = {Faghihi, Faramarz and Moustafa, Ahmed A. and Heinrich, Ralf and W{\"o}rg{\"o}tter, Florentin},
