  author = {Solntseva, S. V. and Kozyrev, S. A. and Nikitin, V. P.},
  year = 2020,
  month = dec,
  journal = {Bulletin of Experimental Biology and Medicine},
  volume = {170},
  number = {2},
  pages = {175--180},
  issn = {1573-8221},
  doi = {10.1007/s10517-020-05027-w},
  urldate = {2020-12-08},
  abstract = {We studied the involvement of NMDA glutamate receptors in the mechanisms of anterograde amnesia. It was found that repeated training of amnestic animals treated with D-cycloserine, a potent agonist of the glycine site of NMDA receptors, did not lead to consolidation of long-term memory, while expression of short-term memory was more pronounced in comparison with control animals that received saline before repeated training. It was shown that D-cycloserine in amnestic snails did not affect the food reactions caused by the presentation of a conditioned stimulus during the reminder (without combination with the unconditioned stimulus). It is assumed that NMDA glutamate receptors in amnestic animals are involved in the neural plasticity mechanisms that underlie short-term memory, but their activation does not influence the anterograde amnesia processes and does not lead to the formation or recovery of long-term memory.},
  langid = {english},
  keywords = {anterograde amnesia,consolidation,glutamate,long-term memory,NMDA,short-term memory}
}

@article{Solomon2019,
  title = {Hippocampal Theta Codes for Distances in Semantic and Temporal Spaces},
  author = {Solomon, Ethan A. and Lega, Bradley C. and Sperling, Michael R. and Kahana, Michael J.},
  year = 2019,
  month = nov,
  journal = {Proceedings of the National Academy of Sciences of the United States of America},
  volume = {116},
  number = {48},
  pages = {24343--24352},
  publisher = {National Academy of Sciences},
  issn = {10916490},
  doi = {10.1073/pnas.1906729116},
  urldate = {2020-01-31},
  abstract = {The medial temporal lobe (MTL) is known to support episodic memory and spatial navigation, raising the possibility that its true function is to form ``cognitive maps'' of any kind of information. Studies in humans and animals support the idea that the hippocampal theta rhythm (4 to 8 Hz) is key to this mapping function, as it has been repeatedly observed during spatial navigation tasks. If episodic memory and spatial navigation are 2 sides of the same coin, we hypothesized that theta oscillations might reflect relations between explicitly nonspatial items, such as words. We asked 189 neurosurgical patients to perform a verbal free-recall task, of which 96 had indwelling electrodes placed in the MTL. Subjects were instructed to remember short lists of sequentially presented nouns. We found that hippocampal theta power and connectivity during item retrieval coded for semantic distances between words, as measured using word2vec-derived subspaces. Additionally, hippocampal theta indexed temporal distances between words after filtering lists on recall performance, to ensure adequate dynamic range in time. Theta effects were noted only for semantic subspaces of 1 dimension, indicating a substantial compression of the possible semantic feature space. These results lend further support to our growing confidence that the MTL forms cognitive maps of arbitrary representational spaces, helping to reconcile longstanding differences between the spatial and episodic memory literatures.},
  pmid = {31723043},
  keywords = {brain oscillation,cognitive map,Cognitive map,Ecall,Episodic memory,Hippocampus,theta,Theta},
  file = {/home/denis/zotero/original/Solomon - 2019 - Hippocampal theta codes for distances in semantic and temporal spaces.pdf}
}

