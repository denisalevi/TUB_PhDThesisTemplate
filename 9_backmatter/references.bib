@article{Hoang2013,
  title = {A Novel {{CPU}}/{{GPU}} Simulation Environment for Large-Scale Biologically Realistic Neural Modeling},
  author = {Hoang, Roger V. and Tanna, Devyani and Jayet Bray, Laurence C. and Dascalu, Sergiu M. and Harris, Frederick C.},
  year = 2013,
  journal = {Frontiers in Neuroinformatics},
  volume = {7},
  number = {October},
  pages = {1--10},
  issn = {1662-5196},
  doi = {10.3389/fninf.2013.00019},
  abstract = {Computational Neuroscience is an emerging field that provides unique opportunities to study complex brain structures through realistic neural simulations. However, as biological details are added to models, the execution time for the simulation becomes longer. Graphics Processing Units (GPUs) are now being utilized to accelerate simulations due to their ability to perform computations in parallel. As such, they have shown significant improvement in execution time compared to Central Processing Units (CPUs). Most neural simulators utilize either multiple CPUs or a single GPU for better performance, but still show limitations in execution time when biological details are not sacrificed. Therefore, we present a novel CPU/GPU simulation environment for large-scale biological networks, the NeoCortical Simulator version 6 (NCS6). NCS6 is a free, open-source, parallelizable, and scalable simulator, designed to run on clusters of multiple machines, potentially with high performance computing devices in each of them. It has built-in leaky-integrate-and-fire (LIF) and Izhikevich (IZH) neuron models, but users also have the capability to design their own plug-in interface for different neuron types as desired. NCS6 is currently able to simulate one million cells and 100 million synapses in quasi real time by distributing data across eight machines with each having two video cards.},
  pmid = {24106475},
  keywords = {biologically realistic,cpu,gpu simulation,izhikevich neurons,large-scale modeling,leaky integrate-and-fire neurons,ncs,neocortical simulator,neocortical simulator (NCS) CPU/GPU simulation l},
  file = {/home/denis/zotero/original/Hoang - 2013 - A novel CPU-GPU simulation environment for large-scale biologically realistic.pdf}
}

@article{Hochreiter2006,
  title = {Support {{Vector Machines}} for {{Dyadic Data}}},
