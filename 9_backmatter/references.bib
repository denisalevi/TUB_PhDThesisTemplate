  title = {Episodic {{Memory}} and {{Beyond}}: {{The Hippocampus}} and {{Neocortex}} in {{Transformation}}},
  author = {Moscovitch, Morris and Cabeza, Roberto and Winocur, Gordon and Nadel, Lynn},
  year = 2016,
