@article{Goto2022,
  title = {Synaptic Plasticity during Systems Memory Consolidation},
  author = {Goto, Akihiro},
  year = 2022,
  month = oct,
  journal = {Neuroscience Research},
  volume = {183},
  pages = {1--6},
  issn = {0168-0102},
  doi = {10.1016/j.neures.2022.05.008},
  urldate = {2022-11-11},
  abstract = {After learning, memory is initially encoded in the hippocampus but subsequently stabilized in other brain regions such as the cortex for long-lasting storage. This process is known as systems memory consolidation, and its cellular mechanism has long been a fundamental question. Synaptic plasticity is the major cellular mechanism underlying learning and memory, and is therefore considered a key function in the process of systems memory consolidation. Therefore, many studies have aimed to establish a causal link between synaptic plasticity in the brain and memory-associated behaviors. In this review, I discuss the various lines of research showing the function of synaptic plasticity, mainly in the hippocampus and cortex during memory consolidation.},
  langid = {english},
  keywords = {anterior cingulate cortex,Anterior cingulate cortex,CALI,hippocampus,Hippocampus,important,Long-term potentiation,optogenetics,Optogenetics,plasticity,structural plasticity,Structural plasticity,synaptic plasticity,Synaptic plasticity,systems memory consolidation,Systems memory consolidation,to-read},
