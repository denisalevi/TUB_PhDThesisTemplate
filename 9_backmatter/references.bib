  issn = {0896-6273},
  doi = {10.1016/S0896-6273(04)00217-X},
  urldate = {2019-04-25},
  abstract = {In the olfactory bulb of vertebrates or the homologous antennal lobe of insects, odor quality is represented by stereotyped patterns of neuronal activity that are reproducible within and between individuals. Using optical imaging to monitor synaptic activity in the Drosophila antennal lobe, we show here that classical conditioning rapidly alters the neural code representing the learned odor by recruiting new synapses into that code. Pairing of an odor-conditioned stimulus with an electric shock-unconditioned stimulus causes new projection neuron synapses to respond to the odor along with those normally activated prior to conditioning. Different odors recruit different groups of projection neurons into the spatial code. The change in odor representation after conditioning appears to be intrinsic to projection neurons. The rapid recruitment by conditioning of new synapses into the representation of sensory information may be a general mechanism underlying many forms of short-term memory.},
