@article{Mao2018,
  title = {Hippocampus-Dependent Emergence of Spatial Sequence Coding in Retrosplenial Cortex},
  author = {Mao, Dun and Neumann, Adam R. and Sun, Jianjun and Bonin, Vincent and Mohajerani, Majid H. and McNaughton, Bruce L.},
  year = 2018,
