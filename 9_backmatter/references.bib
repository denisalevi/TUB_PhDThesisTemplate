  keywords = {Behavior,Electrophysiology,Model,Review,Synaptic consolidation,Synaptic plasticity,Synaptic tagging},
  file = {/home/denis/zotero/original/Clopath - 2012 - Synaptic consolidation - an approach to long-term learning.pdf}
}

@article{Cognigni2018,
  title = {Do the Right Thing: Neural Network Mechanisms of Memory Formation, Expression and Update in {{Drosophila}}},
  author = {Cognigni, Paola and Felsenberg, Johannes and Waddell, Scott},
  year = 2018,
  month = apr,
  journal = {Current Opinion in Neurobiology},
  volume = {49},
  pages = {51--58},
  publisher = {Elsevier Current Trends},
  issn = {0959-4388},
  doi = {10.1016/J.CONB.2017.12.002},
  urldate = {2019-05-08},
  abstract = {When animals learn, plasticity in brain networks that respond to specific cues results in a change in the behavior that these cues elicit. Individual network components in the mushroom bodies of the fruit fly Drosophila melanogaster represent cues, learning signals and behavioral outcomes of learned experience. Recent findings have highlighted the importance of dopamine-driven plasticity and activity in feedback and feedforward connections, between various elements of the mushroom body neural network. These computational motifs have been shown to be crucial for long term olfactory memory consolidation, integration of internal states, re-evaluation and updating of learned information. The often recurrent circuit anatomy and a prolonged requirement for activity in parts of these underlying networks, suggest that self-sustained and precisely timed activity is a fundamental feature of network computations in the insect brain. Together these processes allow flies to continuously adjust the content of their learned knowledge and direct their behavior in a way that best represents learned expectations and serves their most pressing current needs.},
  keywords = {drosophila},
  file = {/home/denis/zotero/original/Cognigni - 2018 - Do the right thing - neural network mechanisms of memory formation, expression.pdf}
}

@article{Cohn2015,
  title = {Coordinated and {{Compartmentalized Neuromodulation Shapes Sensory Processing}} in {{Drosophila}}.},
  author = {Cohn, Raphael and Morantte, Ianessa and Ruta, Vanessa},
  year = 2015,
  month = dec,
  journal = {Cell},
  volume = {163},
  number = {7},
  eprint = {26687359},
  eprinttype = {pubmed},
  pages = {1742--55},
  publisher = {Elsevier},
  issn = {1097-4172},
  doi = {10.1016/j.cell.2015.11.019},
  urldate = {2019-04-23},
  abstract = {Learned and adaptive behaviors rely on neural circuits that flexibly couple the same sensory input to alternative output pathways. Here, we show that the Drosophila mushroom body functions like a switchboard in which neuromodulation reroutes the same odor signal to different behavioral circuits, depending on the state and experience of the fly. Using functional synaptic imaging and electrophysiology, we reveal that dopaminergic inputs to the mushroom body modulate synaptic transmission with exquisite spatial specificity, allowing individual neurons to differentially convey olfactory signals to each of their postsynaptic targets. Moreover, we show that the dopaminergic neurons function as an interconnected network, encoding information about both an animal's external context and internal state to coordinate synaptic plasticity throughout the mushroom body. Our data suggest a general circuit mechanism for behavioral flexibility in which neuromodulatory networks act with synaptic precision to transform a single sensory input into different patterns of output activity. PAPERCLIP.},
  pmid = {26687359},
  keywords = {drosophila},
  file = {/home/denis/zotero/original/Cohn - 2015 - Coordinated and Compartmentalized Neuromodulation Shapes Sensory Processing in.pdf}
}

