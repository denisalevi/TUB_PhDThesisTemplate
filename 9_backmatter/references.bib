@article{Grundemann2019,
  title = {Amygdala Ensembles Encode Behavioral States},
  author = {Gr{\"u}ndemann, Jan and Bitterman, Yael and Lu, Tingjia and Krabbe, Sabine and Grewe, Benjamin F. and Schnitzer, Mark J. and L{\"u}thi, Andreas},
