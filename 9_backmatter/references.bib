@article{Owald2015,
  title = {Activity of Defined Mushroom Body Output Neurons Underlies Learned Olfactory Behavior in {{Drosophila}}.},
  author = {Owald, David and Felsenberg, Johannes and Talbot, Clifford B and Das, Gaurav and Perisse, Emmanuel and Huetteroth, Wolf and Waddell, Scott},
  year = 2015,
