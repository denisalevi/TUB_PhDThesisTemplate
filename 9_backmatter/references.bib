  title = {Aqua-{{Fi}}: {{Delivering Internet Underwater Using Wireless Optical Networks}}},
  shorttitle = {Aqua-{{Fi}}},
  author = {Shihada, Basem and Amin, Osama and Bainbridge, Christopher and Jardak, Seifallah and Alkhazragi, Omar and Ng, Tien Khee and Ooi, Boon and Berumen, Michael and Alouini, Mohamed-Slim},
  year = 2020,
