@article{Pohlchen2020,
  title = {Sleep-Dependent Memory Consolidation in the Light of Rapid Neocortical Plasticity},
  author = {P{\"o}hlchen, Dorothee and Sch{\"o}nauer, Monika},
  year = 2020,
  month = jun,
  journal = {Current Opinion in Behavioral Sciences},
  volume = {33},
  pages = {118--125},
  issn = {2352-1546},
  doi = {10.1016/j.cobeha.2020.02.001},
  urldate = {2020-05-05},
  abstract = {Systems memory consolidation describes a gradual process which shifts the dependence of memories from rapidly plastic hippocampal networks to slower-learning neocortical regions for ultimate long-term storage. Sleep is thought to be crucial for this reorganization. Research over the recent years, however, has discovered rapid neocortical plasticity, and thus questions not only the timescales on which systems consolidation occurs, but also the role of sleep therein. At the same time, new ways to manipulate neural activity have furthered our understanding of how different brain areas interact during sleep and have clarified the relevance of this night-time interchange for systems consolidation. Together, these findings suggest that we need to rethink the ``wheres'' and ``whens'' of sleep-dependent memory processing.},
  langid = {english},
  keywords = {to-read},
  file = {/home/denis/zotero/annotated/Pohlchen - 2020 - Sleep-dependent memory consolidation in the light of rapid neocortical (annotated).pdf;/home/denis/zotero/original/Pohlchen - 2020 - Sleep-dependent memory consolidation in the light of rapid neocortical.pdf}
}

@article{Poo2016,
  title = {What Is Memory? {{The}} Present State of the Engram.},
  author = {Poo, Mu-Ming and Pignatelli, Michele and Ryan, Tom{\'a}s J and Tonegawa, Susumu and Bonhoeffer, Tobias and Martin, Kelsey C and Rudenko, Andrii and Tsai, Li-Huei and Tsien, Richard W and Fishell, Gord and Mullins, Caitlin and Gon{\c c}alves, J Tiago and Shtrahman, Matthew and Johnston, Stephen T and Gage, Fred H and Dan, Yang and Long, John and Buzs{\'a}ki, Gy{\"o}rgy and Stevens, Charles},
  year = 2016,
  journal = {BMC biology},
  volume = {14},
  eprint = {27197636},
  eprinttype = {pubmed},
  pages = {40},
  publisher = {BioMed Central},
  issn = {1741-7007},
  doi = {10.1186/s12915-016-0261-6},
  urldate = {2019-04-23},
  abstract = {The mechanism of memory remains one of the great unsolved problems of biology. Grappling with the question more than a hundred years ago, the German zoologist Richard Semon formulated the concept of the engram, lasting connections in the brain that result from simultaneous "excitations", whose precise physical nature and consequences were out of reach of the biology of his day. Neuroscientists now have the knowledge and tools to tackle this question, however, and this Forum brings together leading contemporary views on the mechanisms of memory and what the engram means today.},
