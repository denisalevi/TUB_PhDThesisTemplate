@mastersthesis{FernandezdelValleAlquicira2022,
  title = {Mechanisms of Memory Consolidation in {{Drosophila}} Melanogaster},
  author = {{Fern{\'a}ndez del Valle Alquicira}, Tania},
  year = 2022,
  month = jan,
  address = {Berlin},
  abstract = {Memory allows using information acquired in the past to navigate the present and plan for the future. This information can be conveyed via a variety of stimuli. Insects heavily rely on olfactory cues to perceive their surroundings. The anatomy of the olfactory system in Drosophila is well-known and in combination with the available genetic tools and well established conditioning paradigms, the fruit fly is an excellent model to understand how olfactory memories are consolidated. Activity of M4/6 output neurons has been shown to be crucial for appetitive and aversive memory expression and that blocking in na\"ive flies induced an approach to  an innately averted odor. For this study, a temperature-sensitive blockade of the M4/6 neurons (MBON-{$\gamma$}5{$\beta\prime$}2a, MBON-{$\beta\prime$}2mp, MBON-{$\beta\prime$}2mp\_bilateral) was achieved individually (M4 and M6) and collectively during the consolidation phase after aversive learning, flies were then tested at a permissive temperature. These results show that M4/6 activity during consolidation is crucial for olfactory associative learning. More specifically, to contribute to the correct assignment of valence, their collective block after training converted aversion into approach which resembles the preference shift after blocking na\"ive flies and contrasts with previous findings of blocking M4/6 during expression. Furthermore, it illustrates that the relevance of the activity of specific MBONs differs at distinct memory stages.},
  school = {Humboldt-Univesit\"at zu Berlin},
  file = {/home/denis/zotero/original/original/Fernandez del Valle Alquicira - 2022 - Mechanisms of memory consolidation in Drosophila melanogaster (PRESENTATION).pdf;/home/denis/zotero/original/original/Fernandez del Valle Alquicira - 2022 - Mechanisms of memory consolidation in Drosophila melanogaster.pdf}
}

