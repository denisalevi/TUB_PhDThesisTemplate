  issn = {0014-0082},
  doi = {10.1055/s-0041-101250},
  abstract = {{$<$}p{$>$}Der Veganismus ist eine Ern\"ahrungs- und Lebensweise. Langj\"ahrige Erfahrungen und wissenschaftliche Daten belegen, dass sich eine vegane Ern\"ahrung g\"unstig auf die Gesundheit auswirkt, sofern eine vollwertige Auswahl der pflanzlichen Lebensmittel getroffen wird und bei Bedarf eine Erg\"anzung kritischer N\"ahrstoffe durch Supplemente oder angereicherte Nahrung erfolgt. Der Veganismus tr\"agt neben der Reduzierung des Risikos von ern\"ahrungsabh\"angigen Erkrankungen durch seine ganzheitlich ausgerichtete Orientierung zu einem nachhaltigen Umweltverhalten bei. Langfristig k\"onnte sich die vegane Lebensweise von einer Rand\-erscheinung unserer Gesellschaft zum Mainstream entwickeln.{$<$}/p{$>$}},
