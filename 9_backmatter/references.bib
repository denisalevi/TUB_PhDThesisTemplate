  volume = {368},
  number = {6486},
  pages = {89--94},
  publisher = {American Association for the Advancement of Science},
  doi = {10.1126/science.aaz9468},
  urldate = {2024-02-21},
  abstract = {Understanding the neurobiological underpinnings of emotion relies on objective readouts of the emotional state of an individual, which remains a major challenge especially in animal models. We found that mice exhibit stereotyped facial expressions in response to emotionally salient events, as well as upon targeted manipulations in emotion-relevant neuronal circuits. Facial expressions were classified into distinct categories using machine learning and reflected the changing intrinsic value of the same sensory stimulus encountered under different homeostatic or affective conditions. Facial expressions revealed emotion features such as intensity, valence, and persistence. Two-photon imaging uncovered insular cortical neuron activity that correlated with specific facial expressions and may encode distinct emotions. Facial expressions thus provide a means to infer emotion states and their neuronal correlates in mice.},
  keywords = {behavior,emotion,facial expresion,to-read},
  file = {/home/denis/zotero/original/Dolensek - 2020 - Facial expressions of emotion states and their neuronal correlates in mice (SUP).pdf;/home/denis/zotero/original/Dolensek - 2020 - Facial expressions of emotion states and their neuronal correlates in mice.pdf}
}

@article{Donato2020,
  title = {The {{Ontogeny}} of {{Hippocampus-Dependent Memories}}},
  author = {Donato, Flavio and Alberini, Cristina M. and Amso, Dima and Dragoi, George and Dranovsky, Alex and Newcombe, Nora S.},
  year = 2020,
  month = dec,
  journal = {Journal of Neuroscience},
  publisher = {Society for Neuroscience},
  issn = {0270-6474, 1529-2401},
  doi = {10.1523/JNEUROSCI.1651-20.2020},
  urldate = {2020-12-22},
  abstract = {The formation of memories that contain information about the specific time and place of acquisition, which are commonly referred to as ``autobiographical'' or ``episodic'' memories, critically relies on the hippocampus and on a series of interconnected structures located in the medial temporal lobe of the mammalian brain. The observation that adults retain very few of these memories from the first years of their life has fueled a long-standing debate on whether infants can make the types of memories that in adults are processed by the hippocampus-dependent memory system, and whether the hippocampus is involved in learning and memory processes early in life. Recent evidence shows that, even at a time when its circuitry is not yet mature, the infant hippocampus is able to produce long-lasting memories. However, the ability to acquire and store such memories relies on molecular pathways and network-based activity dynamics different from the adult system, which mature with age. The mechanisms underlying the formation of hippocampus-dependent memories during infancy, and the role that experience exerts in promoting the maturation of the hippocampus-dependent memory system, remain to be understood. In this review, we discuss recent advances in our understanding of the ontogeny and the biological correlates of hippocampus-dependent memories.},
  chapter = {Feature: Symposium/Mini-symposium},
  copyright = {Copyright \copyright{} 2020 the authors. SfN exclusive license.},
  langid = {english},
  pmid = {33328296},
  keywords = {episodic memory,hippocampus,review,to-read},
  file = {/home/denis/zotero/original/Donato - 2020 - The Ontogeny of Hippocampus-Dependent Memories.pdf}
}

@article{Dorfman2019,
  title = {Causal {{Inference About Good}} and {{Bad Outcomes}}},
  author = {Dorfman, Hayley M. and Bhui, Rahul and Hughes, Brent L. and Gershman, Samuel J.},
  year = 2019,
  month = apr,
  journal = {Psychological Science},
  volume = {30},
  number = {4},
  pages = {516--525},
  publisher = {SAGE Publications Inc},
  issn = {0956-7976},
  doi = {10.1177/0956797619828724},
  urldate = {2021-03-07},
  abstract = {People learn differently from good and bad outcomes. We argue that valence-dependent learning asymmetries are partly driven by beliefs about the causal structure of the environment. If hidden causes can intervene to generate bad (or good) outcomes, then a rational observer will assign blame (or credit) to these hidden causes, rather than to the stable outcome distribution. Thus, a rational observer should learn less from bad outcomes when they are likely to have been generated by a hidden cause, and this pattern should reverse when hidden causes are likely to generate good outcomes. To test this hypothesis, we conducted two experiments (N = 80, N = 255) in which we explicitly manipulated the behavior of hidden agents. This gave rise to both kinds of learning asymmetries in the same paradigm, as predicted by a novel Bayesian model. These results provide a mechanistic framework for understanding how causal attributions contribute to biased learning.},
  langid = {english},
  keywords = {agency,attribution,bayesian inference,Bayesian inference,causal inference,decision making,open data,open materials,preregistered,reinforcement learning,to-read},
  file = {/home/denis/zotero/original/Dorfman - 2019 - Causal Inference About Good and Bad Outcomes (SUP).pdf;/home/denis/zotero/original/Dorfman - 2019 - Causal Inference About Good and Bad Outcomes.pdf}
}

@article{Driscoll2005,
  title = {Seahorse Wins All Races: {{Hippocampus}} Participates in Both Linear and Non-Linear Visual Discrimination Learning},
  shorttitle = {Seahorse Wins All Races},
  author = {Driscoll, Ira and Howard, Sarah R. and Prusky, Glen T. and Rudy, Jerry W. and Sutherland, Robert J.},
  year = 2005,
  month = oct,
  journal = {Behavioural Brain Research},
  volume = {164},
  number = {1},
  pages = {29--35},
  issn = {0166-4328},
  doi = {10.1016/j.bbr.2005.05.006},
  urldate = {2020-09-14},
  abstract = {Consistent with configural/conjunctive theories of the hippocampus, we report that rats trained on the non-linear transverse patterning discrimination problem (A+ versus B-, B+ versus C-, and C+ versus A) displayed retrograde amnesia when the hippocampus was later damaged. They also failed to relearn the solution to this problem. Damage to the hippocampus following training also produced retrograde amnesia in rats trained on a set of elemental discrimination problems (A+ versus B-, C+ versus D-, and E+ versus F-) that could be solved based on the associative strengths of the individual choice cues. However, in contrast to transverse patterning, rats easily relearned and retained these elemental problems and learned a new set of elemental problems after the damage. These results support two theoretical conclusions: (a) elemental discriminations can be learned by both a system that depends on the hippocampus and a system that does not require the hippocampus, and (b) in the intact animal these two systems competitively interact with the hippocampal-dependent system inhibiting memory formation by the extra-hippocampal system.},
  langid = {english},
  keywords = {Amnesia,Discrimination learning,Hippocampus,Transverse patterning},
  file = {/home/denis/zotero/original/Driscoll - 2005 - Seahorse wins all races - Hippocampus participates in both linear and non-linear.pdf}
}

@article{Driscoll2017,
  title = {Dynamic {{Reorganization}} of {{Neuronal Activity Patterns}} in {{Parietal Cortex}}},
  author = {Driscoll, Laura N. and Pettit, Noah L. and Minderer, Matthias and Chettih, Selmaan N. and Harvey, Christopher D.},
  year = 2017,
  month = aug,
  journal = {Cell},
  volume = {170},
  number = {5},
  pages = {986-999.e16},
  issn = {0092-8674},
  doi = {10.1016/j.cell.2017.07.021},
  urldate = {2022-09-20},
  abstract = {Neuronal representations change as associations are learned between sensory stimuli and behavioral actions. However, it is poorly understood whether representations for learned associations stabilize in cortical association areas or continue to change following learning. We tracked the activity of posterior parietal cortex neurons for a month as mice stably performed a virtual-navigation task. The relationship between cells' activity and task features was mostly stable on single days but underwent major reorganization over weeks. The neurons informative about task features (trial type and maze locations) changed across days. Despite changes in individual cells, the population activity had statistically similar properties each day and stable information for over a week. As mice learned additional associations, new activity patterns emerged in the neurons used for existing representations without greatly affecting the rate of change of these representations. We propose that dynamic neuronal activity patterns could balance plasticity for learning and stability for memory.},
  langid = {english},
  keywords = {_tablet,chronic imaging,invivo calcium imaging,learning,mouse parietal cortex,navigation,optogenetics,population dynamics,representational drift,to-read,virtual reality},
  file = {/home/denis/zotero/original/Driscoll - 2017 - Dynamic Reorganization of Neuronal Activity Patterns in Parietal Cortex.pdf}
}

