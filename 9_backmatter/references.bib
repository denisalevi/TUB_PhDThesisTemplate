@article{Simon2022,
  title = {The Functions of Sleep: {{A}} Cognitive Neuroscience Perspective},
  shorttitle = {The Functions of Sleep},
  author = {Simon, Katharine C. and Nadel, Lynn and Payne, Jessica D.},
  year = 2022,
  month = nov,
  journal = {Proceedings of the National Academy of Sciences},
  volume = {119},
  number = {44},
  pages = {e2201795119},
  publisher = {Proceedings of the National Academy of Sciences},
  doi = {10.1073/pnas.2201795119},
  urldate = {2022-11-11},
  abstract = {This Special Feature explores the various purposes served by sleep, describing current attempts to understand how the many functions of sleep are instantiated in neural circuits and cognitive structures. Our feature reflects current experts' opinions about, and insights into, the dynamic processes of sleep. In the last few decades, technological advances have supported the updated view that sleep plays an active role in both cognition and health. However, these roles are far from understood. This collection of articles evaluates the dynamic nature of sleep, how it evolves across the lifespan, becomes a competitive arena for memory systems through the influence of the autonomic system, supports the consolidation and integration of new memories, and how lucid dreams might originate. This set of papers highlights new approaches and insights that will lay the groundwork to eventually understand the full range of functions supported by sleep.},
  keywords = {review,systems memory consolidation. sleep,to-read},
  file = {/home/denis/zotero/original/Simon - 2022 - The functions of sleep.pdf}
}

