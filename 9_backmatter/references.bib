}

@article{Orban2008,
  title = {Bayesian Learning of Visual Chunks by Human Observers},
  author = {Orb{\'a}n, Gerg{\"o} and Fiser, J{\'o}zsef and Aslin, Richard N. and Lengyel, M{\'a}t{\'e}},
  year = 2008,
