@article{Burke2022,
  title = {Serotonin Receptors Contribute to Dopamine Depression of Lateral Inhibition in the Nucleus Accumbens},
  author = {Burke, Dennis A. and Alvarez, Veronica A.},
  year = 2022,
  month = may,
  journal = {Cell Reports},
  volume = {39},
