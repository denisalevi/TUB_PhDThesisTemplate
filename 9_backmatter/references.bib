  title = {Regional {{Specific Evidence}} for {{Memory-Load Dependent Activity}} in the {{Dorsal Subiculum}} and the {{Lateral Entorhinal Cortex}}},
  author = {Ku, Shih-pi and Nakamura, Nozomu H. and Maingret, Nicolas and Mahnke, Liv and Yoshida, Motoharu and Sauvage, Magdalena M.},
