  author = {Luo, Sean X and Axel, Richard and Abbott, L F},
  year = 2010,
  month = jun,
  journal = {Proceedings of the National Academy of Sciences of the United States of America},
  volume = {107},
  number = {23},
  eprint = {20498080},
  eprinttype = {pubmed},
