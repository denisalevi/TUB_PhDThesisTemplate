@article{McNamee2021,
  title = {Flexible Modulation of Sequence Generation in the Entorhinal--Hippocampal System},
  author = {McNamee, Daniel C. and Stachenfeld, Kimberly L. and Botvinick, Matthew M. and Gershman, Samuel J.},
  year = 2021,
