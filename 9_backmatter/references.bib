  urldate = {2020-05-22},
  abstract = {Recent evidence suggests that the hippocampus may integrate overlapping memories into relational representations, or schemas, that link indirectly related events and support flexible memory expression. Here we explored the nature of hippocampal neural population representations for multiple features of events and the locations and contexts in which they occurred. Hippocampal networks developed hierarchical organizations of associated elements of related but separately acquired memories within a context, and distinct organizations for memories where the contexts differentiated object-reward associations. These findings reveal neural mechanisms for the development and organization of relational representations. Video Abstract},
  langid = {english},
  keywords = {consolida},
  file = {/home/denis/zotero/original/McKenzie - 2014 - Hippocampal Representation of Related and Opposing Memories Develop within.pdf}
}

@article{McKenzie2016,
  title = {Representation of Memories in the Cortical--Hippocampal System: {{Results}} from the Application of Population Similarity Analyses},
  shorttitle = {Representation of Memories in the Cortical--Hippocampal System},
  author = {McKenzie, Sam and Keene, Christopher S. and Farovik, Anja and Bladon, John and Place, Ryan and Komorowski, Robert and Eichenbaum, Howard},
  year = 2016,
  month = oct,
  journal = {Neurobiology of Learning and Memory},
